<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    STORAGE_KEY,
    SEPARATOR,
    generateSlug,
    loadBookmarks,
    normalizeUrl,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = readBookmarks();

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Keep the in-memory list usable if storage is unavailable or full.
    }
  }

  function makeSlug() {
    const existing = new Set(bookmarks.map((bookmark) => bookmark.slug));
    let slug;
    do {
      slug = generateSlug(`${Date.now()}-${crypto.randomUUID?.() ?? Math.random()}`);
    } while (existing.has(slug));
    return slug;
  }

  function render() {
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.textContent = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';

      const separator = document.createTextNode(SEPARATOR);

      const badge = document.createElement('span');
      badge.className = 'slug';
      badge.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
        }
      });

      item.append(link, separator, badge, copy);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const url = normalizeUrl(input?.value);
    if (!url) {
      input?.setCustomValidity('Enter a valid URL.');
      input?.reportValidity();
      return;
    }

    input?.setCustomValidity('');
    bookmarks = [...bookmarks, { url, slug: makeSlug() }];
    saveBookmarks();
    render();
    form.reset();
    input?.focus();
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    saveBookmarks();
    render();
  });

  render();
</script>

<style>
  form {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    padding: 1rem;
  }
  #empty-state { border-style: solid; }
  #bookmark-list {
    margin-top: 0.25rem;
  }
  .bookmark {
    background: color-mix(in srgb, currentColor 3%, transparent);
  }
  .bookmark .url {
    color: var(--accent);
  }
</style>
